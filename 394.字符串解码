"""
用栈保存数字和前面的结果，遇到 [ 入栈，遇到 ] 出栈并重复当前串。
【易错点】
数字可能多位，要连续累乘（如 100[abc]）。
嵌套处理：入栈时保存当前 multi 和 res，出栈时恢复外层状态。
字符串乘法优先级：cur_multi * res 是重复 res 再拼接。
【时空复杂度】
- 时间复杂度：O(n)，n 为字符串长度，每个字符最多入栈出栈一次。
- 空间复杂度：O(n)，栈的最大深度与嵌套层数相关，最坏情况下为 n。
【验证示例】
- 编码规则为: k[encoded_string]
- 输入（标准格式，一行字符串）：
- 3[a]2[bc]
- 输出：
- aaabcbc
"""

import sys

class Solution:
    def decodeString(self, s: str) -> str:
        stack = []          # 存储 [multi, res] 对
        multi = 0
        res = ''
        for ch in s:
            if ch == '[':
                stack.append([multi, res])
                multi, res = 0, ''
            elif ch == ']':
                cur_multi, last_res = stack.pop()
                res = last_res + cur_multi * res
            elif ch.isdigit():
                multi = multi * 10 + int(ch)
            else:
                res += ch
        return res


def main():
    # 读取输入（一行字符串）
    s = sys.stdin.read().strip()
    if not s:
        return
    sol = Solution()
    print(sol.decodeString(s))


if __name__ == "__main__":
    main()
