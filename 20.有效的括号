"""
【有效的括号 - 栈 + 哈希表】
【思路】：
遍历字符串，左括号入栈，右括号判断栈顶是否匹配。
不匹配则返回 False，最后栈空则合法。
【易错点】：
1. 奇数长度直接返回 False（剪枝）。
2. 遇到右括号时，必须先检查栈是否为空。
3. 哈希表映射左括号到右括号，便于匹配。
【时空复杂度】：
- 时间 O(n)，空间 O(n)
【输入输出示例】：
示例 1：
输入: "()"
输出: true
"""

import sys

class Solution:
    def isValid(self, s: str) -> bool:
        if len(s) % 2 == 1:
            return False
        dic = {'{': '}', '[': ']', '(': ')'}
        stack = []
        for ch in s:
            if ch in dic:          # 左括号：入栈
                stack.append(ch)
            else:                  # 右括号：必须匹配栈顶
                if not stack or dic[stack.pop()] != ch:
                    return False
        return not stack           # 最后栈必须为空

def main():
    # ACM 输入：通常是一行一个字符串
    data = sys.stdin.read().strip().split()
    if not data:
        return
    s = data[0]  # 取第一个字符串
    sol = Solution()
    print("true" if sol.isValid(s) else "false")

if __name__ == "__main__":
    main()
