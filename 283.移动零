"""
【移动零 - 双指针（快慢指针）】

思路（简洁）：
使用快指针 r 遍历数组，慢指针 l 指向下一个非零元素应该存放的位置。
当 nums[r] != 0 时，交换 nums[l] 和 nums[r]，然后 l++。
这样所有非零元素按顺序移到前面，零自然移到后面。

易错点：
1. 原地修改数组，不需要返回值。
2. 交换时若 l == r，交换无影响，但可以保留。
3. 输入可能为空，直接返回。

时空复杂度：
- 时间 O(n)，每个元素遍历一次
- 空间 O(1)

输入输出示例：
示例 1：
输入: [0,1,0,3,12]
输出: [1,3,12,0,0]

示例 2：
输入: [0]
输出: [0]

示例 3：
输入: [1,0,1]
输出: [1,1,0]
"""

import sys
import json
from typing import List

class Solution:
    def moveZeroes(self, nums: List[int]) -> None:
        l = 0          # 慢指针，指向下一个非零元素的位置
        for r in range(len(nums)):
            if nums[r] != 0:
                nums[l], nums[r] = nums[r], nums[l]
                l += 1

def main():
    data = sys.stdin.read().strip()
    if not data:
        return
    try:
        nums = json.loads(data)
    except:
        # 兼容空格分隔的数字
        nums = list(map(int, data.split()))
    sol = Solution()
    sol.moveZeroes(nums)
    # 输出修改后的数组
    print(json.dumps(nums))

if __name__ == "__main__":
    main()
