"""
【反转链表 - 迭代法】

思路（简洁）：
遍历原链表，依次将当前节点的 next 指向前一个节点，最后返回前一个节点作为新头。

易错点：
1. 必须先保存 cur.next（即 tmp），否则修改 cur.next 后丢失后续节点。
2. 循环结束后 pre 指向反转后的头节点。
3. 空链表直接返回 None。

时空复杂度：
- 时间 O(n)，空间 O(1)

输入输出示例：
示例 1：
输入: [1,2,3,4,5]
输出: [5,4,3,2,1]

示例 2：
输入: [1,2]
输出: [2,1]

示例 3：
输入: []
输出: []
"""

import sys
import json
from typing import Optional, List

class ListNode:
    def __init__(self, val=0, next=None):
        self.val = val
        self.next = next

class Solution:
    def reverseList(self, head: Optional[ListNode]) -> Optional[ListNode]:
        cur = head
        pre = None
        while cur:
            tmp = cur.next          # 保存下一个节点
            cur.next = pre          # 当前节点指向前一个
            pre = cur               # 前一个节点前进
            cur = tmp               # 当前节点前进
        return pre

def build_linked_list(vals: List[int]) -> Optional[ListNode]:
    """将列表转换为链表"""
    dummy = ListNode()
    cur = dummy
    for v in vals:
        cur.next = ListNode(v)
        cur = cur.next
    return dummy.next

def linked_list_to_list(head: Optional[ListNode]) -> List[int]:
    """将链表转换为列表（便于输出）"""
    res = []
    while head:
        res.append(head.val)
        head = head.next
    return res

def main():
    # 读取输入，一行 JSON 数组，如 [1,2,3,4,5]
    data = sys.stdin.read().strip()
    if not data:
        return
    try:
        vals = json.loads(data)
    except:
        # 兼容空格分隔（但通常为 JSON）
        vals = list(map(int, data.split()))
    head = build_linked_list(vals)
    sol = Solution()
    new_head = sol.reverseList(head)
    result = linked_list_to_list(new_head)
    print(json.dumps(result))

if __name__ == "__main__":
    main()
