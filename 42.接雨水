"""
【接雨水 - 双指针】

思路（简洁）：
维护左右两侧的最大高度 left_max 和 right_max，用左右指针从两端向中间移动。
若 left_max <= right_max，说明左侧当前格子能接的水由 left_max 决定，
累加 left_max - height[l] 后 l++；否则右侧同理。

易错点：
1. 指针移动时，若 left_max <= right_max，先计算水量再移动 l；
   否则先计算再移动 r。
2. left_max 和 right_max 初始为 0，每次更新为当前最大值。
3. 注意数组为空或长度小于3时返回0（循环条件自动处理，但可提前判断）。
4. 无需额外数组，空间 O(1)。

时空复杂度：
- 时间 O(n)，每个元素访问一次
- 空间 O(1)

输入输出示例：
示例 1：
输入: [0,1,0,2,1,0,1,3,2,1,2,1]
输出: 6

示例 2：
输入: [4,2,0,3,2,5]
输出: 9

示例 3：
输入: [1,0,1]
输出: 1
"""

import sys
import json
from typing import List

class Solution:
    def trap(self, height: List[int]) -> int:
        n = len(height)
        if n < 3:
            return 0
        l, r = 0, n - 1
        left_max = right_max = 0
        ans = 0
        while l < r:
            left_max = max(left_max, height[l])
            right_max = max(right_max, height[r])
            if left_max <= right_max:
                ans += left_max - height[l]
                l += 1
            else:
                ans += right_max - height[r]
                r -= 1
        return ans

def main():
    data = sys.stdin.read().strip()
    if not data:
        return
    try:
        height = json.loads(data)
    except:
        height = list(map(int, data.split()))
    sol = Solution()
    print(sol.trap(height))

if __name__ == "__main__":
    main()
