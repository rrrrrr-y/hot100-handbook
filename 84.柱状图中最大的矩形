"""
【柱状图中最大的矩形 - 单调栈】

思路（简洁）：
在数组末尾加一个高度 0 作为哨兵，遍历每个柱子作为右边界。
维护单调递增栈（存下标），当当前高度 <= 栈顶高度时，弹出栈顶并计算以该高度为高的最大矩形面积。
宽度 = 右边界 - 左边界 - 1（左边界为弹出后的新栈顶）。

易错点：
1. 哨兵 0 的添加：确保所有柱子都能被弹出计算，且不影响结果（高度 0 不会成为最大）。
2. 栈中初始放入 -1 作为左边界哨兵，简化边界处理。
3. 注意 while 条件中使用 >= 确保相等高度也弹出，避免重复计算且保持严格递增。
4. 计算宽度时：right - left - 1，其中 left 是弹出后的栈顶。

时空复杂度：
- 时间复杂度 O(n)，每个元素入栈出栈一次
- 空间复杂度 O(n)

输入输出示例：
示例 1：
输入: [2,1,5,6,2,3]
输出: 10

示例 2：
输入: 2 4
输出: 4

示例 3：
输入: [1]
输出: 1
"""

import sys
import json
from typing import List

class Solution:
    def largestRectangleArea(self, heights: List[int]) -> int:
        # 添加哨兵，确保所有柱子被处理
        heights.append(0)
        st = [-1]          # 栈中存下标，初始 -1 作为左边界
        ans = 0
        for right, h in enumerate(heights):
            # 当栈顶高度 >= 当前高度时，弹出并计算面积
            while len(st) > 1 and heights[st[-1]] >= h:
                i = st.pop()
                left = st[-1]
                area = heights[i] * (right - left - 1)
                if area > ans:
                    ans = area
            st.append(right)
        return ans


def main():
    data = sys.stdin.read().strip()
    if not data:
        return
    # 输入为 JSON 数组，如 [2,1,5,6,2,3]
    try:
        heights = json.loads(data)
    except:
        # 兼容空格分隔，但通常题目给 JSON
        heights = list(map(int, data.split()))
    sol = Solution()
    print(sol.largestRectangleArea(heights))


if __name__ == "__main__":
    main()
