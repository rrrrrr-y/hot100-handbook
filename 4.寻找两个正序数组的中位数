"""
【寻找两个正序数组的中位数 - 二分查找】

思路（简洁）：
对较短的数组进行二分分割，使得左半部分元素个数等于右半部分（或左多一个）。
通过比较分割线两侧的元素，不断调整分割位置，最终找到满足条件的最大左边界，
从而得到左半部分最大值和右半部分最小值，计算中位数。

易错点：
1. 确保对较短的数组进行二分，减少复杂度。
2. 注意边界条件：分割线可能在数组两端，需用 -inf 和 inf 处理。
3. 二分查找的区间和条件需仔细，本实现使用左闭右开区间（left+1 < right）的方式。
4. 公式 j = (m+n-3)//2 - i 是针对本实现特有的，需保证不会越界。

时空复杂度：
- 时间复杂度 O(log(min(m,n)))
- 空间复杂度 O(1)

输入输出示例：
示例 1：
输入: 
[1,3]
[2]
输出: 2.0

示例 2：
输入: 
[1,2]
[3,4]
输出: 2.5

示例 3：
输入: 
[0,0]
[0,0]
输出: 0.0
"""

import sys
import json
from typing import List
from math import inf

class Solution:
    def findMedianSortedArrays(self, a: List[int], b: List[int]) -> float:
        # 保证 a 是较短的数组
        if len(a) > len(b):
            a, b = b, a
        m, n = len(a), len(b)
        left, right = -1, m
        # 二分查找分割点
        while left + 1 < right:
            i = (left + right) // 2
            j = (m + n - 3) // 2 - i
            if a[i] <= b[j + 1]:
                left = i
            else:
                right = i
        i = left
        j = (m + n - 3) // 2 - i
        # 获取分割线左右两侧的值
        a1 = a[i] if i >= 0 else float('-inf')
        b1 = b[j] if j >= 0 else float('-inf')
        a2 = a[i + 1] if i + 1 < m else float('inf')
        b2 = b[j + 1] if j + 1 < n else float('inf')
        left_max = max(a1, b1)
        right_min = min(a2, b2)
        # 若总数为偶数，取平均；否则取左最大值
        if (m + n) % 2 == 0:
            return (left_max + right_min) / 2.0
        else:
            return left_max


def main():
    # 读取全部输入，按行分割
    data = sys.stdin.read().strip().splitlines()
    if len(data) < 2:
        return
    # 解析两个 JSON 数组
    nums1 = json.loads(data[0].strip())
    nums2 = json.loads(data[1].strip())
    sol = Solution()
    result = sol.findMedianSortedArrays(nums1, nums2)
    # 输出结果，保留一位小数（依据 LeetCode 要求）
    print(f"{result:.1f}")


if __name__ == "__main__":
    main()
